{
  "openapi": "3.1.0",
  "info": {
    "title": "qando API",
    "version": "0.0.0",
    "description": "Generated from the Zod schemas of the contracts package."
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Reports whether the API and its database are up",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Everything is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOk"
                }
              }
            }
          },
          "503": {
            "description": "The database is down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/events/{id}": {
      "get": {
        "summary": "Reads an event through its participation link",
        "tags": [
          "voting"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "The participation ID of the link."
            },
            "required": true,
            "description": "The participation ID of the link."
          }
        ],
        "responses": {
          "200": {
            "description": "The event as participants see it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicEvent"
                }
              }
            }
          },
          "400": {
            "description": "The link is malformed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationFailed"
                }
              }
            }
          },
          "404": {
            "description": "No event has this participation link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "410": {
            "description": "The event was cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventCancelled"
                }
              }
            }
          },
          "500": {
            "description": "The request failed unexpectedly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/events/{id}/participations": {
      "post": {
        "summary": "Casts a vote through the participation link",
        "tags": [
          "voting"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "The participation ID of the link."
            },
            "required": true,
            "description": "The participation ID of the link."
          },
          {
            "in": "header",
            "name": "x-vote-token",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22,64}$",
              "description": "The new vote-edit token. Sending it again stores no second vote and gets the same answer."
            },
            "required": true,
            "description": "The new vote-edit token. Sending it again stores no second vote and gets the same answer."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CastVote"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The vote is stored (or was, by a send with this token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoteCast"
                }
              }
            }
          },
          "400": {
            "description": "The vote was rejected; nothing was stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VoteRejected"
                }
              }
            }
          },
          "404": {
            "description": "No event has this participation link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "409": {
            "description": "Voting is closed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VotingClosed"
                }
              }
            }
          },
          "410": {
            "description": "The event was cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventCancelled"
                }
              }
            }
          },
          "500": {
            "description": "The request failed unexpectedly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/events/{id}/participations/mine": {
      "get": {
        "summary": "Reads the vote of a vote-edit token",
        "tags": [
          "voting"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "The participation ID of the link."
            },
            "required": true,
            "description": "The participation ID of the link."
          },
          {
            "in": "header",
            "name": "x-vote-token",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22,64}$",
              "description": "The vote-edit token the voting page created for this vote."
            },
            "required": true,
            "description": "The vote-edit token the voting page created for this vote."
          }
        ],
        "responses": {
          "200": {
            "description": "The stored vote, whatever the event’s state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyVote"
                }
              }
            }
          },
          "400": {
            "description": "The request breaks the contract",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationFailed"
                }
              }
            }
          },
          "403": {
            "description": "The token holds no vote of this event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Forbidden"
                }
              }
            }
          },
          "404": {
            "description": "No event has this participation link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "410": {
            "description": "The event was cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventCancelled"
                }
              }
            }
          },
          "500": {
            "description": "The request failed unexpectedly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Replaces the vote of a vote-edit token",
        "tags": [
          "voting"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "The participation ID of the link."
            },
            "required": true,
            "description": "The participation ID of the link."
          },
          {
            "in": "header",
            "name": "x-vote-token",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_-]{22,64}$",
              "description": "The vote-edit token the voting page created for this vote."
            },
            "required": true,
            "description": "The vote-edit token the voting page created for this vote."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CastVote"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The vote is replaced; the answer is what was stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MyVote"
                }
              }
            }
          },
          "400": {
            "description": "The edit was rejected; nothing changed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EditVoteRejected"
                }
              }
            }
          },
          "403": {
            "description": "The token holds no vote of this event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Forbidden"
                }
              }
            }
          },
          "404": {
            "description": "No event has this participation link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "409": {
            "description": "Voting is closed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VotingClosed"
                }
              }
            }
          },
          "410": {
            "description": "The event was cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventCancelled"
                }
              }
            }
          },
          "500": {
            "description": "The request failed unexpectedly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CastVote": {
        "type": "object",
        "properties": {
          "name": {
            "description": "Required on named events (2–30 characters trimmed), absent on anonymous ones.",
            "type": "string"
          },
          "votes": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string",
              "enum": [
                "available",
                "preferred",
                "unavailable"
              ]
            },
            "description": "One state per option ID: every option of the event exactly once."
          }
        },
        "required": [
          "votes"
        ],
        "additionalProperties": false,
        "description": "A participant’s answer to every option of the event."
      },
      "HealthOk": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "database": {
            "type": "string",
            "const": "up"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "additionalProperties": false,
        "description": "The API and its database answer."
      },
      "HealthUnavailable": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "unavailable"
          },
          "database": {
            "type": "string",
            "const": "down"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "additionalProperties": false,
        "description": "The database does not answer."
      },
      "PublicEvent": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "organizerName": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "deadline": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "Last day of voting, in `timeZone`."
          },
          "timeZone": {
            "type": "string",
            "description": "IANA name, e.g. `Europe/Madrid`."
          },
          "anonymous": {
            "type": "boolean"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "confirmed"
            ],
            "description": "Closed once the deadline has passed, even before anything else changes it."
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "description": "In chronological order."
          },
          "confirmedOption": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Option"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "title",
          "organizerName",
          "note",
          "deadline",
          "timeZone",
          "anonymous",
          "state",
          "options",
          "confirmedOption"
        ],
        "additionalProperties": false,
        "description": "What a participant may see of an event: never the organizer email, tokens, counts or votes."
      },
      "Option": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "dates": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "single"
                  },
                  "date": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  }
                },
                "required": [
                  "kind",
                  "date"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "range"
                  },
                  "start": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "end": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  }
                },
                "required": [
                  "kind",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            ],
            "type": "object"
          },
          "time": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "single"
                      },
                      "at": {
                        "type": "string",
                        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                      }
                    },
                    "required": [
                      "kind",
                      "at"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "range"
                      },
                      "start": {
                        "type": "string",
                        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                      },
                      "end": {
                        "type": "string",
                        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                      }
                    },
                    "required": [
                      "kind",
                      "start",
                      "end"
                    ],
                    "additionalProperties": false
                  }
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null for a whole day; times only appear on single dates."
          }
        },
        "required": [
          "id",
          "dates",
          "time"
        ],
        "additionalProperties": false,
        "description": "One date the organizer offers."
      },
      "ValidationFailed": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "const": "VALIDATION_FAILED"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/FieldProblem"
                }
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "description": "The request breaks the contract (e.g. a path with broken percent-encoding, a body that is not JSON)."
      },
      "FieldProblem": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "const": "INVALID_FIELD"
          },
          "in": {
            "type": "string",
            "enum": [
              "path",
              "header",
              "body"
            ]
          },
          "path": {
            "type": "array",
            "items": {
              "type": [
                "string",
                "number"
              ]
            }
          }
        },
        "required": [
          "code",
          "in",
          "path"
        ],
        "additionalProperties": false,
        "description": "A part of the request that breaks its schema."
      },
      "NotFound": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "const": "NOT_FOUND"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {}
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "EventCancelled": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "const": "EVENT_CANCELLED"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {}
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "details",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "description": "The event was cancelled; its title is kept."
      },
      "InternalError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "const": "INTERNAL_ERROR"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {}
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "description": "The request failed unexpectedly; it can be retried."
      },
      "VoteCast": {
        "type": "object",
        "properties": {
          "participationId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          }
        },
        "required": [
          "participationId"
        ],
        "additionalProperties": false,
        "description": "The stored vote; the same answer for a repeated send."
      },
      "VoteRejected": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "const": "VALIDATION_FAILED"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/VoteProblem"
                }
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "description": "Nothing was stored: the request breaks the contract, the vote breaks a rule of the event, or the token already belongs to a vote of another event."
      },
      "VoteProblem": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/FieldProblem"
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "const": "NAME_TOO_SHORT"
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "const": "NAME_TOO_LONG"
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "const": "NAME_NOT_ALLOWED"
              }
            },
            "required": [
              "code"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",

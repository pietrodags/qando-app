{
  "openapi": "3.1.0",
  "info": {
    "title": "qando API",
    "version": "0.0.0",
    "description": "Generated from the Zod schemas of the contracts package."
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Reports whether the API and its database are up",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Everything is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOk"
                }
              }
            }
          },
          "503": {
            "description": "The database is down",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthUnavailable"
                }
              }
            }
          }
        }
      }
    },
    "/api/public/events/{id}": {
      "get": {
        "summary": "Reads an event through its participation link",
        "tags": [
          "voting"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "The participation ID of the link."
            },
            "required": true,
            "description": "The participation ID of the link."
          }
        ],
        "responses": {
          "200": {
            "description": "The event as participants see it",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublicEvent"
                }
              }
            }
          },
          "404": {
            "description": "No event has this participation link",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFound"
                }
              }
            }
          },
          "410": {
            "description": "The event was cancelled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EventCancelled"
                }
              }
            }
          },
          "500": {
            "description": "The request failed unexpectedly",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InternalError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthOk": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "database": {
            "type": "string",
            "const": "up"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "additionalProperties": false,
        "description": "The API and its database answer."
      },
      "HealthUnavailable": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "unavailable"
          },
          "database": {
            "type": "string",
            "const": "down"
          }
        },
        "required": [
          "status",
          "database"
        ],
        "additionalProperties": false,
        "description": "The database does not answer."
      },
      "PublicEvent": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "organizerName": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "deadline": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
            "description": "Last day of voting, in `timeZone`."
          },
          "timeZone": {
            "type": "string",
            "description": "IANA name, e.g. `Europe/Madrid`."
          },
          "anonymous": {
            "type": "boolean"
          },
          "state": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "confirmed"
            ],
            "description": "Closed once the deadline has passed, even before anything else changes it."
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Option"
            },
            "description": "In chronological order."
          },
          "confirmedOption": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Option"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "title",
          "organizerName",
          "note",
          "deadline",
          "timeZone",
          "anonymous",
          "state",
          "options",
          "confirmedOption"
        ],
        "additionalProperties": false,
        "description": "What a participant may see of an event: never the organizer email, tokens, counts or votes."
      },
      "Option": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "dates": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "single"
                  },
                  "date": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  }
                },
                "required": [
                  "kind",
                  "date"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "range"
                  },
                  "start": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "end": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  }
                },
                "required": [
                  "kind",
                  "start",
                  "end"
                ],
                "additionalProperties": false
              }
            ],
            "type": "object"
          },
          "time": {
            "anyOf": [
              {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "single"
                      },
                      "at": {
                        "type": "string",
                        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                      }
                    },
                    "required": [
                      "kind",
                      "at"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "kind": {
                        "type": "string",
                        "const": "range"
                      },
                      "start": {
                        "type": "string",
                        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                      },
                      "end": {
                        "type": "string",
                        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                      }
                    },
                    "required": [
                      "kind",
                      "start",
                      "end"
                    ],
                    "additionalProperties": false
                  }
                ],
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Null for a whole day; times only appear on single dates."
          }
        },
        "required": [
          "id",
          "dates",
          "time"
        ],
        "additionalProperties": false,
        "description": "One date the organizer offers."
      },
      "NotFound": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "const": "NOT_FOUND"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {}
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "EventCancelled": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "const": "EVENT_CANCELLED"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {}
              },
              "title": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "details",
              "title"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "description": "The event was cancelled; its title is kept."
      },
      "InternalError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "const": "INTERNAL_ERROR"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {}
              }
            },
            "required": [
              "code",
              "message",
              "details"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false,
        "description": "The request failed unexpectedly; it can be retried."
      }
    }
  }
}

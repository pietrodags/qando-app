            },
            "required": [
              "code",
              "optionId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "const": "OPTION_UNKNOWN"
              },
              "optionId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "optionId"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "const": "SEVERAL_PREFERRED"
              },
              "optionIds": {
                "readOnly": true,
                "type": "array",
                "items": {
                  "type": "string"

{
  "name": "@qando/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./seed": {
      "@qando/source": "./src/seed/index.ts",
      "types": "./dist/seed/index.d.ts",
      "default": "./dist/seed/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "BETTER_AUTH_URL=${BETTER_AUTH_URL:-http://localhost:4200} BETTER_AUTH_SECRET=${BETTER_AUTH_SECRET:-local-development-secret-never-deployed-0123456789} tsx watch --conditions=@qando/source src/main.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=@qando/source src/migrate.ts",
    "db:seed": "tsx --conditions=@qando/source src/seed.ts",
    "mutation": "stryker run"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/mailparser": "^3.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/smtp-server": "^3.5.13",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.11",
    "mailparser": "^3.14.1",
    "smtp-server": "^3.21.3",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@qando/contracts": "0.0.0",
    "@qando/domain": "0.0.0",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  }
}
